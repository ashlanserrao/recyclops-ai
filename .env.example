# Copy to .env and fill in. Never commit .env.

# Measured air quality (required for live data): free key from https://explore.openaq.org/register
OPENAQ_API_KEY=

# AI explanations (optional: without them the app uses template wording and still gives full advice).
# Groq is tried first; OpenAI is the backup.
GROQ_API_KEY=
OPENAI_API_KEY=
